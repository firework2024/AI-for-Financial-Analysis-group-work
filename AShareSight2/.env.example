# AShareSight Backend Configuration
# Copy to .env and fill in your credentials

# LLM API (OpenAI-compatible)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_MODEL=

# RQData (米筐) - Primary A-share Data Source
RQDATA_USERNAME=
RQDATA_PASSWORD=

# Eastmoney Fallback
EASTMONEY_USER_AGENT=AShareSight (contact@example.com)
EASTMONEY_TIMEOUT=12

# Web Search
TAVILY_API_KEY=

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LangGraph Settings
LANGGRAPH_PLANNER_MODE=llm
LANGGRAPH_SYNTHESIZE_MODE=llm
LANGGRAPH_EXECUTE_LIVE_TOOLS=true
INSIGHTS_ENABLED=true

# Agent
BASE_AGENT_MAX_REFLECTIONS=1
PRICE_CB_FAILURE_THRESHOLD=3
PRICE_CB_RECOVERY_TIMEOUT=60
NEWS_CB_FAILURE_THRESHOLD=3
NEWS_CB_RECOVERY_TIMEOUT=180

# LLM Rate-Limit Retry
LLM_RATE_LIMIT_RETRY_MAX_ATTEMPTS=6
LLM_RATE_LIMIT_RETRY_SLEEP_SECONDS=5

# Quality & Guardrails
DATA_CONTEXT_MAX_SKEW_HOURS=24
BUDGET_MAX_TOOL_CALLS=24
BUDGET_MAX_ROUNDS=12
BUDGET_MAX_SECONDS=120
CHAT_HISTORY_MAX_MESSAGES=12

# Database
SQLITE_DB_PATH=data/asharesight.db

# LangGraph checkpointer
LANGGRAPH_CHECKPOINTER_BACKEND=sqlite

# Scheduler
PRICE_ALERT_SCHEDULER_ENABLED=false
NEWS_ALERT_SCHEDULER_ENABLED=false
RISK_ALERT_SCHEDULER_ENABLED=false

# Email Alerts (Optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Frontend runtime API base
VITE_API_BASE_URL=http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO
