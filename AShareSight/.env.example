# AShareSight — 环境变量示例（复制为 .env.server）

# 米筐 RQData（三选一）
# RQDATAC2_CONF=<license_key_json>
# RQDATA_USERNAME=
# RQDATA_PASSWORD=
# RQDATAC_URI=tcp://127.0.0.1:16010

# LLM（必填）
OPENAI_COMPATIBLE_API_KEY=sk-xxx
OPENAI_COMPATIBLE_API_BASE=https://api.example.com/v1
OPENAI_COMPATIBLE_MODEL=your-model

# 可选：Tavily 搜索 fallback
TAVILY_API_KEY=

# 东方财富 HTTP（可选）
EASTMONEY_USER_AGENT=Mozilla/5.0 (AShareSight)
