# Copy this file to `.env` and fill in your local values.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 多智能体并发线程数，控制 LLM 章节写作与 rqdatac 数据拉取的并行度。
# 数值过大可能触发 OpenAI 速率限制，默认 4。
FINAGENT_MAX_WORKERS=4
FINAGENT_VALIDATION_MAX_ROUNDS=2
FINAGENT_CHART_PLACEMENT_MAX_ROUNDS=2

# 原始数据 SQLite 路径（默认 FinAgent/data_store/finagent.db）
FINAGENT_DB_PATH=

# 新对话填写股票代码后，后台自动下载年报并入库行情/财务（默认 true；关闭设 false）
FINAGENT_AUTO_INGEST_ON_NEW_CHAT=true

# 年报已入库且年份满足后，超过 N 天再重新下载解析（0=仅在新报告年份缺失时更新，默认 120）
FINAGENT_ANNUAL_MAX_AGE_DAYS=120

# 对话网页搜索（默认开启；关闭设 FINAGENT_ENABLE_WEB_SEARCH=false）
FINAGENT_ENABLE_WEB_SEARCH=true
# 股价类问题在米筐失败时会自动请求东方财富 push2 API（无需额外 Key）
# 并拉取深度档案：盘口、创业板指标、资金流向、公告、股东户数、行业对比、F10 摘要等（live_data.eastmoney_profile）
# 可选 Tavily API（质量更好，https://tavily.com）
TAVILY_API_KEY=

# ── 米筐 RQData────────────────────────────────────────
# 把 `rqsdk license` 输出的整行 tcp URI 写入下方（勿留空）：
RQDATAC2_CONF='tcp://license:你的token@rqdatad-pro.ricequant.com:16011'

# Web 登录签名密钥（生产环境务必设置随机长字符串；未设置时会自动生成并写入 chat_data/.auth_secret）
FINAGENT_AUTH_SECRET=

# 说明：用户也可在网页侧栏「API 设置」中配置个人大模型 Key，优先于下方服务器默认值。
# 米筐 RQData 仍使用服务器本机授权，暂不支持按用户配置。

# ── LaTeX / PDF 导出（多智能体报告）────────────────────
EXPORT_LATEX=true
COMPILE_PDF=true
# xelatex 不在 PATH 时指定完整路径，例如 XELATEX_PATH=/usr/bin/xelatex
