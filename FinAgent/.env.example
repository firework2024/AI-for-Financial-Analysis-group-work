# Copy this file to `.env` and fill in your local values.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 年报财务 LLM：data_first=先读 metrics/rows 自行归纳；signal_review=逐条审核规则信号（旧模式）
FINAGENT_FINANCIAL_LLM_MODE=data_first

# 并发线程数：米筐批量拉取、多智能体章节写作/修订、对话入库（行情+PIT 并行）
# 数值过大可能触发 OpenAI 429 或米筐连接异常，默认 4；不稳时可改为 2
FINAGENT_MAX_WORKERS=4
# 对话入库：行情与 PIT 财务并行（年报 PDF 仍串行，默认 true）
FINAGENT_INGEST_PARALLEL=true
# 新对话后台入库行情回看天数（默认 90，原逻辑约 120–180）
FINAGENT_BOOTSTRAP_LOOKBACK_DAYS=90
# 对话增量刷新至最近交易日的回看自然日（默认 60）
FINAGENT_QUOTE_REFRESH_LOOKBACK_DAYS=60
# 报告级量价历史回看自然日（多智能体/深度分析，默认 260）
FINAGENT_REPORT_MARKET_LOOKBACK_DAYS=260
# 新对话自动入库是否包含年报 PDF。默认 false，避免大 PDF 拖慢建会话；需要预加载年报时设 true
FINAGENT_BOOTSTRAP_INCLUDE_ANNUAL_REPORT=false
# 米筐 data_executor 多接口并行拉取（默认 true）
FINAGENT_RQDATA_PARALLEL=true
# 多智能体各章节 LLM 并行写作/修订（默认 true，无 API Key 时自动串行）
FINAGENT_SECTION_PARALLEL=true
FINAGENT_VALIDATION_MAX_ROUNDS=2
FINAGENT_CHART_PLACEMENT_MAX_ROUNDS=2
# 验证得分达到该值且无行动项时跳过多智能体章节修订（默认 88）
FINAGENT_VALIDATION_SKIP_REVISE_MIN_SCORE=88

# 原始数据 SQLite 路径（默认 FinAgent/data_store/finagent.db）
FINAGENT_DB_PATH=

# 新对话填写股票代码后，后台自动下载年报并入库行情/财务（默认 true；关闭设 false）
FINAGENT_AUTO_INGEST_ON_NEW_CHAT=true

# 对话中出现 6 位代码或公司简称（如「比亚迪」）时，也会识别并触发入库（依赖上项为 true）

# 年报已入库且年份满足后，超过 N 天再重新下载解析（0=仅在新报告年份缺失时更新，默认 120）
FINAGENT_ANNUAL_MAX_AGE_DAYS=120

# 对话 Agent：loop=多轮思考+按需调工具后作答；single=一次性预取全部工具（旧模式）
FINAGENT_CHAT_AGENT_MODE=loop
# loop 模式下每轮用户消息最多规划步数（每步最多 3 个工具调用）
FINAGENT_CHAT_MAX_STEPS=4

# 对话网页搜索（默认开启；关闭设 FINAGENT_ENABLE_WEB_SEARCH=false）
FINAGENT_ENABLE_WEB_SEARCH=true
# 股价类问题在米筐失败时会自动请求东方财富 push2 API（无需额外 Key）
# 并拉取深度档案：盘口、创业板指标、资金流向、公告、股东户数、行业对比、F10 摘要等（live_data.eastmoney_profile）
# 可选 Tavily API（质量更好，https://tavily.com）
TAVILY_API_KEY=

# ── 米筐 RQData（二选一，勿同时混用）────────────────────
# 方式 A：账号直连（等价于 rqdatac.init(user, password, host)）
# RQ_USER=pkulab
# RQ_PASSWORD=你的密码
# RQ_HOST=222.29.71.3:16010
#
# 方式 B：license TCP URI（`rqsdk license` 输出的整行）
# RQDATAC2_CONF='tcp://license:你的token@rqdatad-pro.ricequant.com:16011'
#
# 若已设置 RQ_USER/RQ_PASSWORD/RQ_HOST，将优先于 RQDATAC2_CONF；请注释或删除未用的方式。
RQDATAC2_CONF=

# Web 登录签名密钥（生产环境务必设置随机长字符串；未设置时会自动生成并写入 chat_data/.auth_secret）
FINAGENT_AUTH_SECRET=

# 说明：用户也可在网页侧栏「设置」中配置个人大模型 Key 与性能参数，优先于下方服务器默认值。
# 米筐 RQData 仍使用服务器本机授权，暂不支持按用户配置。

# ── LaTeX / PDF 导出（多智能体报告）────────────────────
EXPORT_LATEX=true
COMPILE_PDF=true
# xelatex 不在 PATH 时指定完整路径，例如 XELATEX_PATH=/usr/bin/xelatex
